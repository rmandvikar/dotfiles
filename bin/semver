#!/bin/sh

#usage:
#   semver
#       [(-u | --update) (major | minor | patch)] |
#       [--check]
#       <version>
#
# Update or check semver version.

set -e

while true; do
	case "$1" in
		-h | --help) print-file-comments "$0"; exit ;;
		-u | --update)
			shift
			option="$1"
			if [[ "$option" != "major" ]] && [[ "$option" != "minor" ]] && [[ "$option" != "patch" ]]; then
				echo 1>&2 "fatal: unknown option $1"
				exit 1
			fi
			shift
			continue ;;
		--check)
			shift
			option="check"
			continue ;;
		* )
			if [ ! -z "$1" ]; then
				version="$1"
			else
				break
			fi
			shift ;;
	esac
done

semver_regex='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)){0,1}(\+([0-9a-zA-Z-]+(\.[0-9a-zA-Z-]+)*)){0,1}$'
if [[ ! "$version" =~ $semver_regex ]]; then
	echo 1>&2 "fatal: version '$version' is not in semver format"
	exit 1
fi

if [[ "$option" == "check" ]]; then
	exit 0
fi

major_version=$(awk -F'.' '{print $1}' <<< "$version")
major_version=${major_version:=0}
minor_version=$(awk -F'.' '{print $2}' <<< "$version")
minor_version=${minor_version:=0}
patch_version=$(awk -F'.' '{print $3}' <<< "$version")
patch_version=${patch_version:=0}
if grep -q -F '-' <<< "$version"; then
	meta_version="-"$(awk -F'-' '{print $2}' <<< "$version")
elif grep -q -F '+' <<< "$version"; then
	meta_version="+"$(awk -F'+' '{print $2}' <<< "$version")
fi

if [[ "$option" == "major" ]]; then
	major_version=$((major_version + 1))
	updated_version="$major_version.0.0"
elif [[ "$option" == "minor" ]]; then
	minor_version=$((minor_version + 1))
	updated_version="$major_version.$minor_version.0"
elif [[ "$option" == "patch" ]]; then
	patch_version=$((patch_version + 1))
	updated_version="$major_version.$minor_version.$patch_version"
fi
if [[ ! -z "$meta_version" ]]; then
	updated_version="$updated_version$meta_version"
fi
echo "$updated_version"
