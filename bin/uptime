#!/bin/bash

#usage: uptime
#
# Show uptime.

if [[ "$1" == "-h" ]]; then print-file-comments "$0"; exit; fi

#systeminfo | \
#	grep "System Boot Time" | \
#	sed -r 's/System Boot Time:\s+//' | \
#	sed 's/,//'

#net statistics workstation | \
#	grep "Statistics since " | \
#	sed 's/Statistics since //'

# show uptime
up=$(wmic os get lastbootuptime | \
	grep -v "LastBootUpTime" | \
	sed 's,\..*,,' | \
	sed -E 's/(....)(..)(..)(..)(..)(..)/\1-\2-\3 \4:\5:\6/')
date -d "$up" +"%d-%b-%Y %H:%M:%S"

# show uptime delta
upepoch=$(date -d "$up" +%s)
nowepoch=$(date -d "$(date)" +%s)
# days 60*60*24
delta=$(($nowepoch-$upepoch))
echo -n "$(($delta /(60*60*24)))d "
# hours 60*60
delta=$(($delta %(60*60*24)))
echo -n "$(($delta /(60*60)))h "
# mins 60
delta=$(($delta %(60*60)))
echo -n "$(($delta /(60)))m "
# secs
delta=$(($delta %(60)))
echo -n "$(($delta))s"
echo
