#!/bin/sh

#usage: ip
#           [-p | --public]
#           [-a | --all]
#
# Print public / external ip.

while true; do
	case "$1" in
		-h | --help) print-file-comments "$0"; exit ;;
		-p | --public)
			option="public"
			shift
			continue ;;
		-a | --all)
			option="all"
			shift
			continue ;;
		-* )
			if [ ! -z "$1" ]; then
				echo 1>&2 "fatal: unknown option $1"
				exit 1
			fi
			break ;;
		* )
			break ;;
	esac
done

format_ifconfig_output() {
	sed 's_,_\n_' |
		eoflf
}

if [ "$option" == "" ]; then
	curl -s ifconfig.me |
		format_ifconfig_output
elif [ "$option" == "public" ]; then
	curl -s ifconfig.me/all.json |
		jq -r '.forwarded' |
		format_ifconfig_output |
		sed -n '1p'
elif [ "$option" == "all" ]; then
	curl -s ifconfig.me/all.json |
		jq -r '.forwarded' |
		format_ifconfig_output
	
	echo ""
	echo "ip4:"
	curl -s -4 ifconfig.me/all.json |
		jq -r '.forwarded' |
		format_ifconfig_output
	
	echo ""
	echo "ip6:"
	curl -s -6 ifconfig.me/all.json |
		jq -r '.forwarded' |
		format_ifconfig_output
fi
